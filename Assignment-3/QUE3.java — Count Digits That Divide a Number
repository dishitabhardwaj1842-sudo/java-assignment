
public class Main {
    public static void main(String[] args) {
        int num = 1248;
        int original = num;
        int count = 0;

        while (num > 0) {
            int digit = num % 10;

            if (original % digit == 0) {
                count++;
            }

            num = num / 10;
        }

        System.out.println("Count of digits that divide the number: " + count);
    }
}
